# Copy this file to .env and fill in what you have.
# If no API key is set, the assistant automatically runs in offline
# "extractive" mode (no external calls) so the prototype always works.

# --- LLM backend selection -------------------------------------------------
# auto | groq | extractive
# (Anthropic and OpenAI backends have been removed from this build.)
LLM_BACKEND=auto

# --- Groq ---------------------------------------------------------------
# Groq uses an OpenAI-compatible API. Its browser-search fallback avoids a
# separate Serper key for questions outside the onboarding knowledge base.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WEB_SEARCH_ENABLED=auto
GROQ_WEB_SEARCH_MODEL=openai/gpt-oss-20b

# --- Routing / retrieval tuning -----------------------------------------
ROUTING_CONFIDENCE_THRESHOLD=0.08
TOP_K=3

# --- Retrieval backend -----------------------------------------------------
# tfidf -> original scikit-learn TF-IDF cosine similarity retriever
# faiss -> dense-embedding retriever backed by a FAISS index (LSA embeddings
#          by default; automatically upgrades to sentence-transformers if
#          that package + model are available locally)
RETRIEVAL_BACKEND=tfidf

# --- Router backend ----------------------------------------------------------
# rule_based -> keyword + TF-IDF blended router (default, fast, offline)
# llm        -> ask the configured LLM backend to classify the route
#               (falls back to rule_based automatically if the LLM backend
#               is "extractive", since there is no model to ask)
ROUTER_BACKEND=rule_based

# --- Conversation memory ---------------------------------------------------
# Number of prior turns (question+answer pairs) fed back to the LLM as
# context for follow-up questions.
CONVERSATION_MEMORY_TURNS=4

# --- Branding --------------------------------------------------------------
COMPANY_NAME=Example Organization

# --- Admin dashboard login ---------------------------------------------------
# Simple username/password gate in front of the Admin/Analytics page.
# Defaults to admin / admin if left unset - change these before deploying
# anywhere beyond your own machine.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Web search fallback (Serper.dev - Google Search API) ------------------
# Used ONLY when a question doesn't match anything in the local onboarding
# knowledge base. Instead of just declining, the assistant searches the live
# web and answers from that (clearly labeled as web info, with source links).
# Get a free key at https://serper.dev (2,500 free searches, no card needed).
# Leave blank to disable web search entirely - the assistant works fully
# without it.
SERPER_API_KEY=
# auto -> enabled automatically whenever SERPER_API_KEY is set above.
# Set to "false" to keep the key saved but temporarily turn web search off.
WEB_SEARCH_ENABLED=auto
WEB_SEARCH_RESULTS=5
WEB_SEARCH_TIMEOUT=8
